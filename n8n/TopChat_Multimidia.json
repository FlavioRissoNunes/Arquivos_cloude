    {
      "parameters": {
        "jsCode": "// Identifica o tipo da mensagem recebida do TopChat\nreturn $input.all().map((item, i) => {\n  const b = item.json.body || {};\n  const m = Array.isArray(b.mensagem) ? (b.mensagem[0] || {}) : (b.mensagem || {});\n  const t = String(m.mediaType || m.type || m.mimetype || '').toLowerCase();\n\n  let tipo = 'texto';\n  if (/audio|ptt|voice/.test(t)) tipo = 'audio';\n  else if (/image|sticker/.test(t)) tipo = 'imagem';\n  else if (/document|application|pdf/.test(t)) tipo = 'documento';\n\n  let url = m.mediaUrl || m.url || '';\n  if (url && !url.startsWith('http')) url = 'https://api.topchat.com.br/public/' + url;\n  if (!url) tipo = 'texto';\n\n  const texto = m.body || m.text || m.caption || '';\n  return { json: { tipo, url, texto }, pairedItem: i };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
